# PlayScout mobile — public runtime config only.
#
# Every EXPO_PUBLIC_* value ships inside the client bundle. NEVER put a secret
# here: no Supabase service-role key, no AI provider keys (Anthropic, Google,
# Perplexity, OpenAI), no Railway/Vercel/worker credentials. Those live only on
# the server. The mobile app authenticates with the Supabase anon key + the
# signed-in user's JWT, exactly like the web browser client does.

# Supabase project URL and public anon key (Dashboard → Project Settings → API).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the PlayScout web/API deployment the app talks to.
EXPO_PUBLIC_API_URL=https://playscout.ai

# Sentry DSN for crash/error reporting (optional — no-ops when unset).
EXPO_PUBLIC_SENTRY_DSN=
